# YourTal local development — copy to .env and adjust nothing to start.
# Ports are in the 26xxx range because this machine runs other Postgres
# instances on 5432 / 15432 / 55499 / 55510.
#
# Loaded automatically from the repo root by every `pnpm dev`/`start`/`seed`
# script (`node --env-file-if-exists=../../.env`) and by
# `packages/db/scripts/atlas.mjs` (`process.loadEnvFile`) — nothing else in
# this repo reads it. A real environment variable already set in the shell
# always wins over a value from this file; a deployed environment that
# passes its own env vars and has no `.env` at all boots exactly the same
# way, since a missing file is not an error for either loader.

NODE_ENV=development
# dev | staging. Staging shows the web banner and tells robots to stay out;
# the web build bakes it into static pages, so build with it set too.
APP_ENV=dev
# Public origin for canonical, OG and sitemap URLs, read at web build time.
# Unset means https://yourtal.com; staging builds with its own host.
# SITE_URL=https://yourtal.com
PORT=3001
# apps/web/app/dev/inbox reads this to reach the api. Only needed when the
# web dev server is not just using apps/api's own PORT above (e.g. a slot
# worktree's api runs on a different loopback port than 127.0.0.1).
# API_BASE_URL=http://127.0.0.1:3001

# F12 "Sessions" (1.5.e): consumer 30 days sliding / 90 days absolute, staff
# 12h flat. These are the defaults already; uncomment only to override.
# SESSION_CONSUMER_IDLE_TTL_MS=2592000000
# SESSION_CONSUMER_ABSOLUTE_TTL_MS=7776000000
# SESSION_STAFF_ABSOLUTE_TTL_MS=43200000

# `apps/web`'s server-only `apiFetch` (1.7.a) — never exposed to the
# browser, no `NEXT_PUBLIC_` prefix. No default in code on purpose: a
# silently-wrong API host is worse than a loud failure the first time a
# Server Component calls out. Matches `PORT` above; a slot worktree points
# this at its own api port instead (see `infra/PORTS.md`).
API_INTERNAL_URL=http://127.0.0.1:3001

# Cerbos sidecar (docker-compose). Loopback only, never a shared PDP.
PDP_BASE_URL=http://127.0.0.1:26592
PDP_TIMEOUT_MS=500

# Local Postgres (docker-compose). Credentials are local-only by design.
# The RUNTIME role. Unprivileged on purpose: the schema's GRANT/REVOKE
# boundaries only mean anything if the app connects as a role they apply
# to. `yourtal` is SUPERUSER + BYPASSRLS and ignores all of them, which is
# what it used to be set to — see YT-0554 and risk 45. The API asserts this
# at boot and refuses to start as a privileged role.
DATABASE_URL=postgres://yourtal_app:app_local_only@127.0.0.1:26432/yourtal

# Signs checkpoint tokens (YT-0121). REQUIRED, min 32 chars, no default in
# env.schema.ts on purpose: a committed default is a key every reader of this
# repository holds, and a forged checkpoint token claims presence for video
# nobody watched. This local value is deliberately implausible as a real key.
CHECKPOINT_TOKEN_SECRET=local-only-checkpoint-signing-key-not-a-real-secret

# The OWNER role. Migrations only — Atlas needs DDL rights the app must not
# have. Nothing that serves a request should ever read this.
DATABASE_OWNER_URL=postgres://yourtal:yourtal_local_only@127.0.0.1:26432/yourtal

# services/ledger and services/voucher (docker-compose, YT-0517). Go, not
# Node — neither `--env-file-if-exists` nor `atlas.mjs` reads this file, so
# these two lines exist for a developer running `go run ./cmd/ledger` or
# `go run ./cmd/voucher` OUTSIDE docker-compose against the same shared
# Postgres; inside compose, docker-compose.yml sets the container's own copy
# of these directly and this file is not consulted.
#
# Each is its OWN role, never DATABASE_URL's yourtal_app and never
# DATABASE_OWNER_URL's superuser. yourtal_app has no grant on the ledger
# schema at all (infra/postgres/init/01-schemas.sql) and connecting as
# either as the ledger or voucher service would be YT-0554's bug one layer
# down — this is exactly the mistake main.go made before this pass, reading
# the generic DATABASE_URL for the invariant checker's pool.
LEDGER_DATABASE_URL=postgres://yourtal_ledger:ledger_local_only@127.0.0.1:26432/yourtal
VOUCHER_DATABASE_URL=postgres://yourtal_voucher:voucher_local_only@127.0.0.1:26432/yourtal

# Shared HMAC secret apps/api and apps/worker sign ledger calls with (>= 32 bytes).
LEDGER_SERVICE_SECRET=local-only-ledger-service-secret-not-real
# apps/api signs completed reward sessions with this; the ledger pays only a
# completion it verifies (>= 32 bytes).
REWARD_ATTESTATION_SECRET=local-only-reward-attestation-secret-not-real

# Shared HMAC secret apps/api and apps/worker sign voucher-internal calls
# with (>= 32 bytes). A separate secret from the ledger's own — a compromised
# ledger secret must not also let a caller mint or redeem vouchers.
VOUCHER_SERVICE_SECRET=local-only-voucher-service-secret-not-real

# TASKS.md 1.2.d: fake|live for LedgerInternalClient/VoucherInternalClient.
# `fake` needs no network call (platform.ledger_fake_*/voucher_fake_*);
# `live` reads the two URLs below. Defaults to fake since the real routes
# are still 501s (4.1.b).
LEDGER_MODE=fake
LEDGER_BASE_URL=http://127.0.0.1:26312
VOUCHER_BASE_URL=http://127.0.0.1:26313

# Where services/voucher's master keyring lives. Inside docker-compose the
# `voucher-keygen` service generates one straight into the
# `yourtal-voucher-keys` DOCKER VOLUME on first `pnpm dev:up` and this
# variable is not needed. Running voucher directly on the host instead, set
# this to a directory OUTSIDE this repository — services/voucher/internal/
# keyring refuses to load a master key that has a `.git` ancestor, by
# design, so a path under this checkout will not work. See
# docker-compose.yml's header comment for the exact commands.
# VOUCHER_KEY_DIR=/absolute/path/outside/this/repo/voucher-keys

# Valkey (Redis-compatible) — sessions, rate limits, checkpoint nonces,
# price locks, idempotency claims.
REDIS_URL=redis://127.0.0.1:26379

# 13-17-year-olds with parental consent (1.4.b, F4). Default false
# everywhere; only 12.1 sets this to "true", and only on staging.
TEEN_ACCOUNTS=false

# Local object storage (YT-0521). S3-compatible, so the R2 adapter is
# exercised rather than stubbed.
S3_ENDPOINT=http://127.0.0.1:26900
S3_ACCESS_KEY=yourtal
S3_SECRET_KEY=yourtal_local_only
S3_BUCKET=yourtal-media

# Cloudflare Turnstile publishes official always-pass / always-fail test
# keys, so bot-gating is testable with no Cloudflare account (YT-0052).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# External boundaries (YT-0535). Every one of them runs a simulator by
# default, so these are all commented out on purpose: absent means
# "simulated", and that is the behaviour a fresh clone and CI both want.
#
# Setting one to "live" requires that boundary's credentials to be present.
# If they are not, the process REFUSES TO START rather than falling back —
# a silent fallback in production is indistinguishable from working, and you
# would ship a payment flow that settles nothing and reports success.
#
# A value that is neither "simulated" nor "live" is also a boot failure, so
# a typo cannot quietly mean "simulated".
#
# PAYMENTS_DRIVER=simulated          # needs PAYMENTS_API_KEY, PAYMENTS_WEBHOOK_SECRET
# DISBURSEMENT_DRIVER=simulated      # needs DISBURSEMENT_API_KEY, DISBURSEMENT_WEBHOOK_SECRET
# BOT_CHECK_DRIVER=simulated         # needs TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY (already set below)
# OTP_DRIVER=simulated               # needs OTP_API_KEY, OTP_SENDER_ID
# DEVICE_REPUTATION_DRIVER=simulated  # needs DEVICE_REPUTATION_API_KEY (YT-0051)
# MESSAGING_DRIVER=simulated         # needs MESSAGING_API_KEY, MESSAGING_SENDER_ID
# DIGITAL_GOODS_DRIVER=simulated     # needs DIGITAL_GOODS_API_KEY
# RECEIPT_INGEST_DRIVER=simulated    # needs RECEIPT_INGEST_API_KEY
# MODERATION_DRIVER=simulated        # needs MODERATION_API_KEY
# EMAIL_DRIVER=simulated             # needs EMAIL_API_KEY (1.6.a)
# PUSH_DRIVER=simulated              # needs PUSH_API_KEY (1.6.c)
# WEBHOOK_DRIVER=simulated           # needs WEBHOOK_SIGNING_SECRET (1.6.c)

