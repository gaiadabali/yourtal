# YourTal local development — copy to .env and adjust nothing to start.
# Ports are in the 26xxx range because this machine runs other Postgres
# instances on 5432 / 15432 / 55499 / 55510.
#
# Loaded automatically from the repo root by every `pnpm dev`/`start`/`seed`
# script (`node --env-file-if-exists=../../.env`) and by
# `packages/db/scripts/atlas.mjs` (`process.loadEnvFile`) — nothing else in
# this repo reads it. A real environment variable already set in the shell
# always wins over a value from this file; a deployed environment that
# passes its own env vars and has no `.env` at all boots exactly the same
# way, since a missing file is not an error for either loader.

NODE_ENV=development
PORT=3001

# Cerbos sidecar (docker-compose). Loopback only, never a shared PDP.
PDP_BASE_URL=http://127.0.0.1:26592
PDP_TIMEOUT_MS=500

# Local Postgres (docker-compose). Credentials are local-only by design.
# The RUNTIME role. Unprivileged on purpose: the schema's GRANT/REVOKE
# boundaries only mean anything if the app connects as a role they apply
# to. `yourtal` is SUPERUSER + BYPASSRLS and ignores all of them, which is
# what it used to be set to — see YT-0554 and risk 45. The API asserts this
# at boot and refuses to start as a privileged role.
DATABASE_URL=postgres://yourtal_app:app_local_only@127.0.0.1:26432/yourtal

# The OWNER role. Migrations only — Atlas needs DDL rights the app must not
# have. Nothing that serves a request should ever read this.
DATABASE_OWNER_URL=postgres://yourtal:yourtal_local_only@127.0.0.1:26432/yourtal

# Valkey (Redis-compatible) — sessions, rate limits, checkpoint nonces,
# price locks, idempotency claims.
REDIS_URL=redis://127.0.0.1:26379

# Local identity provider (YT-0520). Real OIDC, real tokens.
OIDC_ISSUER_URL=http://localhost:26080
# Bootstrap login: dev@yourtal.local / DevPassword1!

# Local object storage (YT-0521). S3-compatible, so the R2 adapter is
# exercised rather than stubbed.
S3_ENDPOINT=http://127.0.0.1:26900
S3_ACCESS_KEY=yourtal
S3_SECRET_KEY=yourtal_local_only
S3_BUCKET=yourtal-media

# Cloudflare Turnstile publishes official always-pass / always-fail test
# keys, so bot-gating is testable with no Cloudflare account (YT-0052).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# External boundaries (YT-0535). Every one of them runs a simulator by
# default, so these are all commented out on purpose: absent means
# "simulated", and that is the behaviour a fresh clone and CI both want.
#
# Setting one to "live" requires that boundary's credentials to be present.
# If they are not, the process REFUSES TO START rather than falling back —
# a silent fallback in production is indistinguishable from working, and you
# would ship a payment flow that settles nothing and reports success.
#
# A value that is neither "simulated" nor "live" is also a boot failure, so
# a typo cannot quietly mean "simulated".
#
# PAYMENTS_DRIVER=simulated          # needs PAYMENTS_API_KEY, PAYMENTS_WEBHOOK_SECRET
# DISBURSEMENT_DRIVER=simulated      # needs DISBURSEMENT_API_KEY, DISBURSEMENT_WEBHOOK_SECRET
# BOT_CHECK_DRIVER=simulated         # needs TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY (already set below)
# OTP_DRIVER=simulated               # needs OTP_API_KEY, OTP_SENDER_ID
# MESSAGING_DRIVER=simulated         # needs MESSAGING_API_KEY, MESSAGING_SENDER_ID
# DIGITAL_GOODS_DRIVER=simulated     # needs DIGITAL_GOODS_API_KEY
# RECEIPT_INGEST_DRIVER=simulated    # needs RECEIPT_INGEST_API_KEY
# MODERATION_DRIVER=simulated        # needs MODERATION_API_KEY

