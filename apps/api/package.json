{
  "name": "@yourtal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "build": "node ../../scripts/build-service.mjs api",
    "start:dist": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node ../../packages/db/scripts/with-test-db.mjs -- vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.0.3",
    "@yourtal/authz": "workspace:*",
    "@yourtal/consent": "workspace:*",
    "@yourtal/contracts": "workspace:*",
    "@yourtal/db": "workspace:*",
    "@yourtal/drivers": "workspace:*",
    "@yourtal/idempotency": "workspace:*",
    "@yourtal/jurisdiction": "workspace:*",
    "@yourtal/media": "workspace:*",
    "@yourtal/paysim": "workspace:*",
    "@yourtal/queue": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "nestjs-zod": "5.5.0",
    "neverthrow": "8.2.0",
    "oidc-provider": "9.13.3",
    "otpauth": "9.5.2",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.21",
    "@types/oidc-provider": "9.13.1",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@yourtal/tsconfig": "workspace:*",
    "openid-client": "6.8.9",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
