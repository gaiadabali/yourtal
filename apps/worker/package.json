{
  "name": "@yourtal/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/main.ts",
    "build": "node ../../scripts/build-service.mjs worker",
    "start:dist": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node ../../packages/db/scripts/with-test-db.mjs -- vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/s3-request-presigner": "3.1141.0",
    "@node-rs/argon2": "2.2.1",
    "@yourtal/contracts": "workspace:*",
    "@yourtal/db": "workspace:*",
    "@yourtal/drivers": "workspace:*",
    "@yourtal/jurisdiction": "workspace:*",
    "@yourtal/media": "workspace:*",
    "@yourtal/queue": "workspace:*",
    "neverthrow": "8.2.0",
    "pg": "8.23.0",
    "pg-boss": "12.35.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.2",
    "@types/pg": "8.23.1",
    "@yourtal/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
