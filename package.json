{
  "name": "yourtal",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
