    "tasks:check": "node scripts/tasks.mjs --check"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
