        },
        "required": [
          "businessId",
          "name",
          "email",
          "phone",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "Business": {
        "description": "An advertiser, supplier and/or redeemer.\n\nRules NOT enforced by this schema (they cannot be expressed in JSON Schema, and are\nenforced only by the Zod schema in @yourtal/contracts):\n  - roles must not contain duplicates.",
