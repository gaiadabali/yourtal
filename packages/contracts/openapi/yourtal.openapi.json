        "enum": [
          "advertiser",
          "supplier",
          "redeemer"
        ]
      },
      "BusinessTeamRole": {
        "description": "The job one person does inside one business (docs/17 section 2.1). Defined here rather than in @yourtal/authz because a member carries it in an API payload; authz imports it and keeps the drift test against the Cerbos principal schema (YT-0509). Store staff are absent by design — they are device sessions, not members.",
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "marketer",
          "merchandiser",
          "finance",
          "analyst"
        ]
      },
      "Campaign": {
        "description": "The earn-loop unit. Duration, reward, data cost and question count are never optional — the entry card is a contract with the viewer (docs/17 section 1.2).\n\nRules NOT enforced by this schema (they cannot be expressed in JSON Schema, and are\nenforced only by the Zod schema in @yourtal/contracts):\n  - A quick campaign must be 60 seconds or shorter (docs/17 section 1.1).\n  - An accuracy bonus requires at least one question to score accuracy against.\n  - A long_form campaign must have at least one chapter; a quick campaign has none.\n  - The first chapter must start at second 0.\n  - Chapter start times must be strictly increasing.\n  - Every chapter must start before the campaign's own durationSeconds.",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kind": {
            "$ref": "#/components/schemas/CampaignKind"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "merchantId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "merchantName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "synopsis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "durationSeconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10800
          },
          "estimatedDataMb": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2000
          },
          "rewardPoints": {
            "$ref": "#/components/schemas/Points"
          },
          "questionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "scoringRule": {
            "$ref": "#/components/schemas/CampaignScoringRule"
          },
          "status": {
            "$ref": "#/components/schemas/CampaignStatus"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CampaignChapter"
            }
          },
          "videoSource": {
            "$ref": "#/components/schemas/CampaignVideoSource"
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "merchantId",
          "merchantName",
          "synopsis",
          "durationSeconds",
          "estimatedDataMb",
          "rewardPoints",
          "questionCount",
          "scoringRule",
          "status",
          "publishedAt",
          "chapters",
          "videoSource"
