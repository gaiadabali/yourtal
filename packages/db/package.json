{
  "name": "@yourtal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./dsar-handlers": "./src/dsar-handlers.ts",
    "./dsar-payment-handlers": "./src/dsar-payment-handlers.ts",
    "./invoicing/issue": "./src/invoicing/issue-invoice.ts",
    "./invoicing/sources": "./src/invoicing/sources.ts",
    "./invoicing/types": "./src/invoicing/types.ts",
    "./invoicing/fixtures": "./src/invoicing/invoice-fixtures.ts",
    "./demo-world/reset": "./src/seed/demo-world/reset.ts",
    "./demo-world/activity": "./src/seed/demo-world/activity.ts",
    "./demo-world/marketplace": "./src/seed/demo-world/marketplace.ts",
    "./demo-world/card": "./src/seed/demo-world/card.ts",
    "./demo-world/api-client": "./src/seed/demo-world/api-client.ts"
  },
  "scripts": {
    "migrate": "node scripts/atlas.mjs apply",
    "migrate:status": "node scripts/atlas.mjs status",
    "migrate:hash": "node scripts/atlas.mjs hash",
    "seed": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/with-test-db.mjs -- vitest run",
    "lint": "eslint .",
    "demo:reset": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/seed/main-demo-reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@node-rs/argon2": "2.2.1",
    "@yourtal/consent": "workspace:*",
    "@yourtal/contracts": "workspace:*",
    "@yourtal/jurisdiction": "workspace:*",
    "@yourtal/media": "workspace:*",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.2",
    "@types/pg": "8.23.1",
    "@yourtal/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
