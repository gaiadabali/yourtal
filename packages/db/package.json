{
  "name": "@yourtal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node scripts/atlas.mjs apply",
    "migrate:status": "node scripts/atlas.mjs status",
    "migrate:hash": "node scripts/atlas.mjs hash",
    "seed": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/with-test-db.mjs -- vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@yourtal/consent": "workspace:*",
    "@yourtal/contracts": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.2",
    "@types/pg": "8.23.1",
    "@yourtal/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
