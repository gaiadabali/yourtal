  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.2",
    "@types/pg": "8.23.1",
    "@yourtal/tsconfig": "workspace:*",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
