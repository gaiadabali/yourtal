{
  "name": "@yourtal/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./hls-origin": "./src/hls-origin.ts",
    "./publish-fixture": "./src/publish-fixture.ts",
    "./kyb-object-storage": "./src/kyb-object-storage.ts",
    "./studio-media": "./src/studio-media.ts",
    "./hls-session-url": "./src/hls-session-url.ts",
    "./ffmpeg-transcode": "./src/ffmpeg-transcode.ts"
  },
  "scripts": {
    "publish:fixture": "node --import @swc-node/register/esm-register src/publish-fixture.ts",
    "fixture:generate": "node scripts/generate-fixture.mjs",
    "demo:media": "node --env-file-if-exists=../../.env --import @swc-node/register/esm-register src/demo-media.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
