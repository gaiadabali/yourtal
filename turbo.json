{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typegen": {
      "outputs": [".next/types/**"]
    },
    "@yourtal/web#lint": {
      "dependsOn": ["@yourtal/web#typegen"]
    },
    "@yourtal/web#typecheck": {
      "dependsOn": ["^build", "@yourtal/web#typegen"]
    }
  }
}
